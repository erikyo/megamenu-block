{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "megamenu/menu",
  "title": "Mega Menu",
  "category": "layout",
  "icon": "menu",
  "allowedBlocks": [
    "megamenu/menu-item",
    "codekraft/oh-my-svg",
    "core/group",
    "core/heading",
    "core/paragraph",
    "core/site-logo",
    "core/social-links",
    "core/search",
    "core/spacer",
    "core/columns",
    "core/buttons",
    "core/list"
  ],
  "providesContext": {
    "megamenu/menusMinWidth": "menusMinWidth",
    "megamenu/expandDropdown": "expandDropdown"
  },
  "attributes": {
    "activator": {
      "type": "string",
      "default": "hover"
    },
    "menusMinWidth": {
      "type": "number",
      "default": 0
    },
    "dropdownMaxWidth": {
      "type": "number",
      "default": 0
    },
    "collapseOnMobile": {
      "type": "boolean",
      "default": true
    },
    "responsiveBreakpoint": {
      "type": "number",
      "default": 1023
    },
    "expandDropdown": {
      "type": "boolean",
      "default": true
    },
    "style": {
      "type": "object",
      "default": {
        "shadow": "var:preset|shadow|deep"
      }
    }
  },
  "supports": {
    "align": [
      "left",
      "center",
      "right",
      "wide",
      "full"
    ],
    "className": true,
    "color": {
      "text": true,
      "background": true,
      "link": true,
      "gradients": true,
      "heading": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "layout": {
      "allowEditing": true,
      "default": {
        "type": "flex",
        "flexWrap": "wrap"
      }
    },
    "dimensions": {
      "width": true,
      "minHeight": false
    },
    "position": {
      "sticky": true
    },
    "shadow": {
      "__experimentalSkipSerialization": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalTextDecoration": true,
      "__experimentalFontStyle": true,
      "__experimentalFontWeight": true,
      "__experimentalLetterSpacing": true,
      "__experimentalTextTransform": true,
      "__experimentalWritingMode": true
    },
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "viewScriptModule": "file:./view.js",
  "editorStyle": "file:./index.css",
  "viewStyle": "file:./style-view.css",
  "render_callback": "render_megamenu_menu"
}
