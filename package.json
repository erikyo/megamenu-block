{
	"name": "megamenu-block",
	"version": "1.0.0",
	"description": "WordPress Mega Menu Block",
	"authors": [
		"MotoPress",
		"erikyo"
	],
	"files": [
		"build",
		"languages",
		"megamenu-block.php",
		"readme.txt"
	],
	"license": "GPL-2.0-or-later",
	"devDependencies": {
		"@types/wordpress__blocks": "^12.5.14",
		"@types/wordpress__compose": "^6.1.0",
		"@types/wordpress__element": "^2.14.1",
		"@wordpress/blocks": "^15.19.0",
		"@wordpress/compose": "^7.46.0",
		"@wordpress/i18n": "^5.0.0",
		"@wordpress/icons": "^10.32.0",
		"@wordpress/scripts": "32.2.0",
		"@wp-blocks/make-pot": "^1.6.6",
		"classnames": "^2.5.1"
	},
	"scripts": {
		"start": "wp-scripts start",
		"build": "npm run build:scripts && npm run build:makepot",
		"build:scripts": "wp-scripts build",
		"build:makepot": "npx @wp-blocks/make-pot",
		"build:zip": "wp-scripts plugin-zip",
		"format:js": "wp-scripts format-js",
		"lint:js": "wp-scripts lint-js",
		"wp-env:start": "npx wp-env start",
		"wp-env:stop": "npx wp-env stop",
		"@wordpress/block-editor": "^15.19.0",
		"wp-env:destroy": "npx wp-env destroy"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"eslintConfig": {
		"extends": [
			"plugin:@wordpress/eslint-plugin/recommended"
		],
		"env": {
			"browser": true,
			"node": true
		},
		"globals": {
			"window": true,
			"document": true,
			"localStorage": true
		}
	},
	"prettier": "@wordpress/prettier-config"
}
